# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: Cloudflare Turnstile (anti-bots en registro/login).
# Si lo completás, activá también Captcha en Supabase → Authentication → Attack Protection.
VITE_TURNSTILE_SITE_KEY=

# Opcional: aviso por mail de cada formulario (chismes, casting, publicidad, ideas).
# Sacá la clave gratis en https://web3forms.com con el mail donde querés recibirlos.
VITE_WEB3FORMS_KEY=
